DJANGO_SECRET_KEY=
MYSQL_NAME=vehicle_rental
MYSQL_USER=vehicle_rental
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments: choose explicitly. "fake" moves no money and is allowed only with
# DJANGO_DEBUG=1 or DJANGO_DEMO_MODE=1 (a public demo; the UI labels it). "razorpay"
# needs TEST keys (rzp_test_...) and a webhook secret; live keys are refused.
PAYMENT_PROVIDER=fake
DJANGO_DEMO_MODE=0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
SITE_URL=http://localhost:8000
