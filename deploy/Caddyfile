# HTTPS terminator for Motorlane. Caddy gets and renews the certificate for {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip

	# Uploaded vehicle photos are served straight from the shared media volume.
	# Thumbnails have content-hashed names, so they can be cached forever; originals for a day.
	@thumbnails path /media/vehicles/thumbs/*
	header @thumbnails Cache-Control "public, max-age=31536000, immutable"
	handle_path /media/* {
		root * /srv/media
		header ?Cache-Control "public, max-age=86400"
		file_server
	}

	# Everything else (the React app, API, admin, health checks) goes to Django.
	handle {
		reverse_proxy web:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output stdout
		format json
	}
}
