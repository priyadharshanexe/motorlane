# Copy to deploy/.env.production (git-ignored) and fill in. Never commit real values.

# Public hostname. Its DNS A/AAAA record must point at the server before the first start.
DOMAIN=motorlane.example.com
# 127.0.0.1 and localhost are needed for the container health checks.
DJANGO_ALLOWED_HOSTS=motorlane.example.com,127.0.0.1,localhost
SITE_URL=https://motorlane.example.com

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

MYSQL_NAME=vehicle_rental
MYSQL_USER=vehicle_rental
MYSQL_PASSWORD=

# --- Public demo (portfolio) ---------------------------------------------------------
# Demo mode allows the built-in demo payment provider (no money moves; the UI says so),
# seeds demo accounts on first boot, and with DEMO_DAILY_RESET=1 wipes and re-seeds all
# data every day at DEMO_RESET_HOUR (server local time, Asia/Kolkata by default).
DJANGO_DEMO_MODE=1
DEMO_DAILY_RESET=1
DEMO_RESET_HOUR=3
PAYMENT_PROVIDER=fake
# Password shared by the demo accounts (owner@rental-demo.example, renter@rental-demo.example ...).
RENTAL_DEMO_PASSWORD=

# --- Razorpay test mode (optional, instead of the demo provider) ---------------------
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------------
# A public demo should not send real email: keep the console backend (messages appear in
# `docker compose logs web`). For real delivery use SMTP settings instead.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_EMAIL_HOST=
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_FROM_EMAIL=Motorlane <noreply@motorlane.example.com>

# Optional Google sign-in (register https://<DOMAIN>/accounts/google/login/callback/).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
